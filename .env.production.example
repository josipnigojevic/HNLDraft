# Copy to .env.production, replace every example value, then chmod 600.
# DOMAIN must be the bare hostname, without https:// or a trailing slash.
DOMAIN=hnl38.example
ACME_EMAIL=admin@example.com

# Generate once with: openssl rand -hex 32
# Keep this stable. Changing it makes existing password hashes unverifiable.
HNL_AUTH_PEPPER=replace-with-at-least-64-random-hex-characters

# Login sessions are secure, HttpOnly cookies in production.
HNL_SECURE_COOKIES=1
HNL_AUTH_SESSION_SECONDS=2592000

# Keep the OWASP-aligned scrypt work factor unless the production host has
# been deliberately benchmarked. 131072 is 2^17.
HNL_PASSWORD_SCRYPT_N=131072

# Caddy sanitizes the forwarded address before the API trusts it.
HNL_TRUST_PROXY=1
HNL_AUTH_RATE_LIMIT_ATTEMPTS=10
HNL_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Optional resource tuning.
HNL_ROOM_TTL_SECONDS=86400
