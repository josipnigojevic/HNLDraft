FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HNL_API_HOST=0.0.0.0 \
    HNL_API_PORT=8000 \
    HNL_ROOMS_DB=/data/rooms.sqlite3 \
    HNL_CATALOG_PATH=/app/data/hnl_draft_catalog.json

WORKDIR /app

RUN useradd --create-home --uid 10001 appuser

COPY --chown=appuser:appuser api_rooms.py ./
COPY --chown=appuser:appuser data/hnl_draft_catalog.json ./data/hnl_draft_catalog.json
RUN mkdir -p /data && chown appuser:appuser /data

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).read()"]

CMD ["python", "api_rooms.py"]
